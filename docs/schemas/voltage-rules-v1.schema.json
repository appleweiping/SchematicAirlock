{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schematic-airlock.org/schemas/voltage-rules-v1.schema.json",
  "title": "DC voltage-envelope rules, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version"],
  "properties": {
    "schema": {"const": "org.schematic-airlock.voltage-rules"},
    "version": {"const": 1},
    "net_envelopes": {"$ref": "#/$defs/envelopes"},
    "source_envelopes": {"$ref": "#/$defs/envelopes"},
    "expected": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "positive", "negative", "min", "max"],
        "properties": {
          "name": {"$ref": "#/$defs/name"}, "positive": {"$ref": "#/$defs/name"},
          "negative": {"$ref": "#/$defs/name"}, "min": {"$ref": "#/$defs/volts"},
          "max": {"$ref": "#/$defs/volts"}
        }
      }
    },
    "models": {
      "type": "object", "maxProperties": 1000,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["kind", "limits"],
            "properties": {
              "kind": {"const": "M"},
              "limits": {
                "type": "object", "additionalProperties": false,
                "required": ["gs", "gd", "gb", "ds", "bs", "bd"],
                "properties": {
                  "gs": {"$ref": "#/$defs/interval"}, "gd": {"$ref": "#/$defs/interval"},
                  "gb": {"$ref": "#/$defs/interval"}, "ds": {"$ref": "#/$defs/interval"},
                  "bs": {"$ref": "#/$defs/interval"}, "bd": {"$ref": "#/$defs/interval"}
                }
              }
            }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["kind", "limits"],
            "properties": {
              "kind": {"const": "D"},
              "limits": {
                "type": "object", "additionalProperties": false, "required": ["ak"],
                "properties": {"ak": {"$ref": "#/$defs/interval"}}
              }
            }
          }
        ]
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "max_constraints": {"type": "integer", "minimum": 1, "maximum": 3000000},
        "max_edge_visits": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "max_queries": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"},
    "volts": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]{1,3})?$"},
    "interval": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": {"min": {"$ref": "#/$defs/volts"}, "max": {"$ref": "#/$defs/volts"}}
    },
    "envelopes": {
      "type": "object", "maxProperties": 1000,
      "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/interval"}
    }
  }
}
